# RALLY API - copy to .env and adjust. Never commit the real file.
APP_NAME=RALLY API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
VERSION=0.1.0
# Brand
BRAND_NAME=RALLY
BRAND_TAGLINE=Find your people. Do more together.
# Auth - set a long random signing key before any real deployment
SECRET_KEY=dev-insecure-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
MIN_PASSWORD_LENGTH=8
# Payments: mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
# Email / transactional mail (provider: outbox | smtp | console)
EMAIL_PROVIDER=outbox
EMAIL_FROM=RALLY <no-reply@rally.local>
FRONTEND_BASE_URL=http://localhost:4173
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
OUTBOX_DIR=var/outbox
# Media / uploads (relative to the apps/api working directory)
MEDIA_ROOT=var/media
MAX_UPLOAD_MB=5
# Datastores
DATABASE_URL=sqlite:///./rally_dev.db
REDIS_URL=redis://localhost:6379/0
# CORS (comma separated)
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=20
RATE_LIMIT_AUTH_REFILL_PER_SEC=0.5

# Self-refreshing demo events (local SQLite dev/e2e only; keep demo kegiatan upcoming)
EVENT_REFRESH_ENABLED=true
