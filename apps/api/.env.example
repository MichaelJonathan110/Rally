# ---------------------------------------------------------------------------
# RALLY backend environment. Copy to `.env` and adjust. NEVER commit `.env`.
# Every variable here is read by app/core/config.py (pydantic-settings).
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
APP_NAME=RALLY API
ENVIRONMENT=development          # development | staging | production
DEBUG=false
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Brand (single source of truth) ---------------------------------------
BRAND_NAME=RALLY
BRAND_TAGLINE=Find your people. Do more together.

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Datastores ------------------------------------------------------------
# SQLAlchemy 2.0 URL. psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://rally:rally@localhost:5432/rally
REDIS_URL=redis://localhost:6379/0

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
